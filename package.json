{
	"name": "@eddiewang/pi-predict",
	"version": "0.1.0",
	"description": "Predicts the owner's next reply when a Pi run ends, with the session model and its cached prefix.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"prediction",
		"ensemble"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"license": "MIT",
	"author": "Eddie Wang",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eddiewang/pi-config.git",
		"directory": "packages/pi-predict"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"files": [
		"src/",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"vitest": "4.1.11"
	}
}
